# --- Kopiér til .env.local (lokalt) eller saet som environment-variabler i Coolify ---
# Bemaerk: NEXT_PUBLIC_*-variabler bages ind i frontend-bundlet ved BUILD, saa de
# skal vaere sat naar imaget bygges i Coolify (ikke kun ved runtime).

# Supabase — OFFENTLIG API (gennem Kong). Browseren bruger denne til auth + skriv.
# Den selvhostede Zeekr-instans paa Pixa skal eksponeres offentligt (Cloudflare
# Tunnel) foer login/skriv virker udefra. Studio ligger paa LAN: http://192.168.1.18:8002
NEXT_PUBLIC_SUPABASE_URL=https://api.zeekr-garage.dk
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VALGFRI: intern Supabase-URL til server-side laesning (SSR) inde paa Pixas
# Docker-netvaerk — hurtigere og uafhaengig af den offentlige vej. Er den tom,
# bruges NEXT_PUBLIC_SUPABASE_URL ogsaa server-side.
# Fx: http://supabase-kong-zdmeluhkaf6buop6l6vlhj2s:8000
SUPABASE_INTERNAL_URL=

# Vis-navn og domaene (saa det kun staar ét sted)
SITE_NAME=Zeekr Garage
SITE_DOMAIN=zeekr-garage.dk
SITE_URL=https://zeekr-garage.dk

# --- Oversættelse af rapporter (PDF/CSV) til engelsk/svensk ---
# Selvhostet LibreTranslate på Pixa (via Coolify). Peg på instansens adresse,
# fx http://192.168.1.18:5000 eller den interne Docker-adresse. Er den tom,
# er rapporter kun på dansk (alt virker stadig).
LIBRETRANSLATE_URL=
# Kun hvis din LibreTranslate-instans kræver en API-nøgle (LT_API_KEYS):
LIBRETRANSLATE_API_KEY=
# Trin 2 (bedre kvalitet på rapporten): selvhostet NLLB-600M on-demand-service på
# Pixa (se nllb-service/). Er den sat, bruger RAPPORTEN NLLB med graceful fallback
# til LibreTranslate ved fejl; er den tom, bruges LibreTranslate direkte. Sæt den
# FØRST når servicens /health svarer. Fx http://<coolify-service-navn>:8000
# (forummet bruger altid LibreTranslate/gist - ikke denne).
NLLB_URL=
